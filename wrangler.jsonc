// Producción en Cloudflare. La tienda es estática (dist/, servida por ASSETS) y
// el Worker de worker/index.ts solo atiende /api/*: el Club Flemin (cuentas,
// suscripción mensual y descargas de STL/3MF desde R2).
// `npm run desplegar` compila y la sube. La primera vez: `npm run club:preparar`
// (crea la base de datos D1 y el almacén R2 y rellena el database_id de abajo).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "biblioteca-3d",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Una sola página: cualquier ruta sirve index.html.
    "not_found_handling": "single-page-application",
    // /api/* va al Worker; todo lo demás sale directo de dist/ sin gastar peticiones.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "biblioteca-3d-club",
      "database_id": "5273b0fb-88a3-41df-9f87-9ba11bc50917",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARCHIVOS",
      "bucket_name": "biblioteca-3d-archivos"
    }
  ],
  "vars": {
    // Precio que se muestra en la web. El que se cobra es el del plan de PayPal.
    "PRECIO_CLUB": "9.99",
    // 'sandbox' para probar con cuentas falsas de PayPal; 'live' para cobrar de verdad.
    "PAYPAL_ENTORNO": "sandbox",
    // Se rellenan al crear la app y el plan en developer.paypal.com (ver CLUB.md).
    // El secreto va aparte: npx wrangler secret put PAYPAL_SECRETO
    "PAYPAL_CLIENT_ID": "",
    "PAYPAL_PLAN_ID": "",
    // Quien entre con estos correos ve el panel de administrador (activar socios a mano).
    "ADMIN_CORREOS": "fleremias@outlook.com",
    "WHATSAPP": "593979523040"
  }
}
